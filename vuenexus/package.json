{
  "name": "vuenexus",
  "version": "0.1.3",
  "description": "VueNexus analyzes Vue projects into precise TS/Vue graph and embedding stores.",
  "type": "module",
  "bin": {
    "vuenexus": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "models",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "index": "node dist/cli.js index",
    "mcp": "node dist/cli.js mcp"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.16.1",
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/compiler-sfc": "^3.5.0",
    "commander": "^12.1.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
